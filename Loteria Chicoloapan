<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>ESPAÑOL 3°B LOTERÍA DE CHICOLOAPAN</title>

<style>

body{
    margin:0;
    font-family:Arial, sans-serif;
    text-align:center;
    background:linear-gradient(to bottom,#006847,#ffffff,#ce1126);
}

h1{
    color:#fff;
    font-size:3rem;
    text-shadow:3px 3px 5px black;
    margin-top:10px;
}

h2{
    color:#fff;
}

#timer{
    font-size:2rem;
    font-weight:bold;
    color:#fff;
    margin:10px;
}

#cartaActual{
    width:320px;
    height:380px;
    background:white;
    margin:auto;
    border-radius:20px;
    box-shadow:0 0 20px black;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
}

#cartaActual img{
    width:90%;
    height:280px;
    object-fit:cover;
    border-radius:10px;
}

#nombreCarta{
    font-size:1.5rem;
    font-weight:bold;
    padding:10px;
}

button{
    padding:15px 25px;
    margin:10px;
    font-size:18px;
    border:none;
    border-radius:10px;
    cursor:pointer;
}

#siguiente{
    background:#006847;
    color:white;
}

#victoria{
    background:#FFD700;
    color:black;
}

#reiniciar{
    background:#ce1126;
    color:white;
}

.tablero{
    width:95%;
    margin:auto;
    margin-top:20px;
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:10px;
}

.casilla{
    background:white;
    padding:10px;
    border-radius:10px;
    cursor:pointer;
    font-size:14px;
    min-height:60px;
}

.marcada{
    background:#FFD700;
    font-weight:bold;
}

#ganador{
    display:none;
    font-size:3rem;
    color:white;
    font-weight:bold;
    margin-top:20px;
    text-shadow:2px 2px 5px black;
}

@media(max-width:768px){

h1{
font-size:2rem;
}

.tablero{
grid-template-columns:repeat(2,1fr);
}

}

</style>
</head>

<body>

<h1>ESPAÑOL 3°B</h1>

<h2>LOTERÍA DE CHICOLOAPAN</h2>

<div id="timer">00:00</div>

<div id="cartaActual">

https://via.placeholder.com/300x280?text=Chicoloapan

<div id="nombreCarta">
Presiona Iniciar
</div>

</div>

<br>

<button id="siguiente">
🎴 Siguiente Carta
</button>

<button id="victoria">
🏆 ¡LOTERÍA!
</button>

<button id="reiniciar">
🔄 Reiniciar
</button>

<div id="ganador">
🏆 ¡GANASTE! 🏆
</div>

<div class="tablero" id="tablero"></div>

<script>

const cartas = [

"Palacio Municipal",
"Parroquia San Vicente",
"Kiosco",
"Mercado Municipal",
"Cerro",
"Biblioteca",
"Escuela",
"Cancha",
"Fiesta Patronal",
"Danza",
"Banda",
"Artesanía",
"Nopal",
"Maíz",
"Milpa",
"Borrego",
"Caballo",
"Iglesia",
"Campanario",
"Plaza",
"Fuente",
"Arcos",
"Bandera",
"Estudiante",
"Libro",
"Lápiz",
"Maestra",
"Sol",
"Luna",
"Águila",
"Tlacuache",
"Conejo",
"Perro",
"Gato",
"Mariposa",
"Árbol",
"Flor",
"Río",
"Puente",
"Parque",
"Autobús",
"Bicicleta",
"Familia",
"Niño",
"Niña",
"Amigo",
"Amiga",
"Maguey",
"Cactus",
"Cultura",
"Tradición",
"Historia",
"Comunidad",
"Chicoloapan"

];

let usadas = [];

const tablero = document.getElementById("tablero");

function crearTablero(){

tablero.innerHTML="";

for(let i=0;i<16;i++){

const carta =
cartas[Math.floor(Math.random()*cartas.length)];

const div=document.createElement("div");
div.className="casilla";
div.innerText=carta;

div.onclick=()=>{

div.classList.toggle("marcada");

};

tablero.appendChild(div);

}
}

crearTablero();

let segundos=0;

setInterval(()=>{

segundos++;

let min=Math.floor(segundos/60);
let seg=segundos%60;

document.getElementById("timer").innerHTML=
String(min).padStart(2,"0")+":"+
String(seg).padStart(2,"0");

},1000);

function hablar(texto){

const voz=
new SpeechSynthesisUtterance(texto);

voz.lang="es-MX";

speechSynthesis.speak(voz);

}

document.getElementById("siguiente")
.addEventListener("click",()=>{

if(usadas.length===cartas.length){

alert("Fin del juego");

return;

}

let indice;

do{

indice=
Math.floor(Math.random()*cartas.length);

}
while(usadas.includes(indice));

usadas.push(indice);

const carta=cartas[indice];

document.getElementById("nombreCarta")
.innerHTML=carta;

document.getElementById("imagenCarta")
.src=
"https://via.placeholder.com/300x280/ffffff/000000?text="
+encodeURIComponent(carta);

hablar(carta);

});

document.getElementById("victoria")
.addEventListener("click",()=>{

document.getElementById("ganador")
.style.display="block";

hablar(
"Felicidades. Has ganado la lotería de Chicoloapan."
);

});

document.getElementById("reiniciar")
.addEventListener("click",()=>{

location.reload();

});

</script>

</body>
</html>
